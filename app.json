{
  "expo": {
    "name": "Raw Adventure",
    "slug": "RawAdventureRN",
    "scheme": "rawadventure",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F1E8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "world.rawadventure.app",
      "associatedDomains": [
        "applinks:rawadventure.world"
      ]
    },
    "android": {
      "package": "world.rawadventure.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F1E8"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "rawadventure.world",
              "pathPrefix": "/subscription-success"
            },
            {
              "scheme": "https",
              "host": "rawadventure.world",
              "pathPrefix": "/checkout-success"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser"
    ]
  }
}
